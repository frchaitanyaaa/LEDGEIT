# ---- Database ----
DATABASE_URL=postgresql+psycopg://ledgeit:ledgeit@localhost:5432/ledgeit
# Superuser connection used ONLY by scripts/tamper-lab (simulates a malicious DBA)
TAMPER_DATABASE_URL=postgresql+psycopg://ledgeit:ledgeit@localhost:5432/ledgeit

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---- Evidence storage ----
# STORAGE_BACKEND=s3 uses MinIO; STORAGE_BACKEND=local writes to STORAGE_DIR (dev/tests)
STORAGE_BACKEND=s3
STORAGE_DIR=./var/evidence
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ledgeit
S3_SECRET_KEY=ledgeit123
S3_BUCKET=evidence

# ---- Queue ----
REDIS_URL=redis://localhost:6379/0

# ---- AI inspector ----
AI_INSPECTOR_URL=http://localhost:8001
# MODEL_BACKEND=stub (deterministic, no weights) | yolo (needs services/ai-inspector/models/*.pt)
MODEL_BACKEND=stub

# ---- Chain ----
# CHAIN=local (Hardhat node) | amoy (Polygon Amoy testnet) | none (anchoring disabled)
CHAIN=local
RPC_URL_LOCAL=http://localhost:8545
RPC_URL_AMOY=https://rpc-amoy.polygon.technology
# Hardhat account #0 private key (public, dev only). NEVER put a real key here.
ANCHOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=

# ---- Public URLs ----
PUBLIC_BASE_URL=http://localhost:5173
